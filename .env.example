# ==========================================
# TrustPay Environment Configuration
# ==========================================

APP_ENV=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000

# Set to true ONLY if you want to force simulated mock mode
MOCK_MODE=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./trustpay.db

# Groq API (Primary LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal Sandbox API (Live Sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Sandbox Configuration (Fails closed if Docker is unavailable)
SANDBOX_MODE=docker
SANDBOX_TIMEOUT_SECONDS=30
ALLOW_LOCAL_SANDBOX_FALLBACK=false
