# ==========================================
# TrustPay Environment Configuration
# ==========================================

APP_ENV=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
DEMO_TOOLS=true

# Set to true for CI / test mock mode only
MOCK_MODE=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./trustpay.db

# LLM Provider: 'groq' (default) or 'anthropic'
LLM_PROVIDER=groq

# Groq API (Default LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic API (Alternative LLM Provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# PayPal Sandbox API (Live Sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Code Sandbox Configuration: "e2b" | "docker" | "disabled" (FAIL CLOSED)
SANDBOX_PROVIDER=disabled
SANDBOX_TIMEOUT_SECONDS=30
E2B_API_KEY=your_e2b_api_key_here
