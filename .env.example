# ==========================================
# TrustPay Environment Configuration
# ==========================================

# Application
APP_ENV=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
# Default: sqlite+aiosqlite:///./trustpay.db (Postgres compatible: postgresql+asyncpg://user:pass@host:5432/trustpay)
DATABASE_URL=sqlite+aiosqlite:///./trustpay.db

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# PayPal Sandbox API
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Sandbox Execution Mode ('docker' or 'local')
SANDBOX_MODE=local
SANDBOX_TIMEOUT_SECONDS=30
